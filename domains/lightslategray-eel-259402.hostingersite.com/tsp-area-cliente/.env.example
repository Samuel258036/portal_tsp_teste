# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" para o GitHub.

# String de conexão do MySQL criado no hPanel da Hostinger.
# Formato: mysql://usuario:senha@host:3306/nome_do_banco
# Se o backend rodar FORA da Hostinger (Vercel, Railway...), é preciso:
#   1. Ativar "MySQL Remoto" no hPanel e liberar o IP do servidor do backend.
#   2. Usar o host remoto que a Hostinger fornece (geralmente o IP do servidor, não "localhost").
DATABASE_URL="mysql://usuario:senha@host:3306/u872285189_xxxxx"

# Chave secreta usada para assinar o cookie de sessão do cliente.
# Gere uma string aleatória longa, ex: openssl rand -base64 32
SESSION_SECRET="troque-por-uma-chave-aleatoria-longa"

# Chave da API da Anthropic, usada para gerar os resumos em linguagem simples.
# Fica só no servidor — nunca é exposta ao navegador do cliente.
ANTHROPIC_API_KEY="sk-ant-..."

# Credenciais usadas na rotina de coleta do PJe Comunica.
PJE_OAB_NUMERO="123456"
PJE_OAB_UF="XX"
